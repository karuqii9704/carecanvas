# `demo` is deterministic, costs nothing, and requires no external services.
CARECANVAS_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# fal.ai (server-only)
FAL_KEY=
FAL_WEBHOOK_URL=https://your-domain.example/api/fal/webhook

# Inngest (server-only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Supabase. Only the URL and anon key are public; service role stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live cost guardrails
CARECANVAS_DAILY_LIMIT=1
CARECANVAS_LIFETIME_LIMIT=50
