# `demo` is deterministic and free. `harness` runs the selected intelligence
# provider with bundled images. `live` additionally requires fal, Inngest, and Supabase.
CARECANVAS_MODE=demo
CARECANVAS_INTELLIGENCE_PROVIDER=anthropic
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (server-only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Gemini (server-only). Use `harness` + `gemini` to run real brief, safety,
# and visual-QA calls without enabling the durable image-provider stack.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# fal.ai (server-only)
FAL_KEY=
FAL_WEBHOOK_URL=https://your-domain.example/api/fal/webhook

# Inngest (server-only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Supabase. Only the URL and anon key are public; service role stays server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live cost guardrails
CARECANVAS_DAILY_LIMIT=1
CARECANVAS_LIFETIME_LIMIT=50
